require('dotenv').config();
const TelegramBot = require('node-telegram-bot-api');
const axios = require('axios');
const express = require('express');

const token = process.env.BOT_TOKEN || '7782817245:AAHfY5rsgPPy0lLc76dTSKHs_AHi20s16is';
const chapaKey = process.env.CHAPA_SECRET_KEY || 'CHASECK_TEST-eYkXJfJwsHVWq2b2tZbCiZEv81tzeghe';

const bot = new TelegramBot(token, { polling: true });
const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json());

app.get('/', (req, res) => {
  res.send('YEMA Pay Telegram Bot is running successfully!');
});

bot.onText(/\/start/, (msg) => {
  const chatId = msg.chat.id;
  const welcomeText = `እንኳን ወደ YEMA Pay በደህና መጡ!\n\nክፍያ ለመፈጸም ከታች ያለውን አዝራር ይጫኑ፦`;

  const opts = {
    reply_markup: {
      inline_keyboard: [
        [{ text: '💳 በChapa ይክፈሉ (10 ETB)', callback_data: 'pay_10' }]
      ]
    }
  };

  bot.sendMessage(chatId, welcomeText, opts);
});

bot.on('callback_query', async (query) => {
  const chatId = query.message.chat.id;
  const data = query.data;

  if (data === 'pay_10') {
    const txRef = `YEMA-${Date.now()}`;

    try {
      const response = await axios.post(
        'https://api.chapa.co/v1/transaction/initialize',
        {
          amount: '10',
          currency: 'ETB',
          email: 'customer@yema.com',
          first_name: query.from.first_name || 'Customer',
          last_name: query.from.last_name || 'User',
          tx_ref: txRef,
          callback_url: 'https://api.chapa.co',
          return_url: 'https://t.me/YemaTestPayBot',
          'customization[title]': 'YEMA Pay Payment',
          'customization[description]': 'Payment for Telegram Bot Service'
        },
        {
          headers: {
            Authorization: `Bearer ${chapaKey}`,
            'Content-Type': 'application/json'
          }
        }
      );

      if (response.data && response.data.status === 'success') {
        const checkoutUrl = response.data.data.checkout_url;
        bot.sendMessage(chatId, `እባክዎ ክፍያውን ለመጨረስ ይህንን ሊንክ ይጫኑ፦\n\n${checkoutUrl}`);
      } else {
        bot.sendMessage(chatId, 'የክፍያ ሊንክ ማመንጨት አልተቻለም። እባክዎ እንደገና ይሞክሩ።');
      }
    } catch (error) {
      console.error('Chapa API Error:', error.response ? error.response.data : error.message);
      bot.sendMessage(chatId, 'ክፍያውን በማስጀመር ላይ ሳለን ስህተት አጋጥሟል።');
    }
  }
});

app.listen(PORT, () => {
  console.log(`Server is running on port ${PORT}`);
});
