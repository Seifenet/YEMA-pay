const { Telegraf, Markup } = require('telegraf');
const axios = require('axios');
const express = require('express');

const app = express();
app.use(express.json());

const BOT_TOKEN = process.env.BOT_TOKEN;
const CHAPA_SECRET = process.env.CHAPA_SECRET_KEY;
const PORT = process.env.PORT || 3000;

const bot = new Telegraf(BOT_TOKEN);

bot.start((ctx) => {
  ctx.reply(
    `እንኳን ወደ YEMA Pay በደህና መጡ! 🚀\n\nየክፍያ ሊንክ ለማመንጨት የዕቃውን ስም እና ዋጋ ይጻፉ።\n\nለምሳሌ፡ ጫማ 1500 ወይም ራይድ 350`
  );
});

bot.on('text', async (ctx) => {
  const text = ctx.message.text.trim();
  if (text.startsWith('/')) return;

  const parts = text.split(' ');
  const amount = Number(parts[parts.length - 1]);
  const itemName = parts.slice(0, -1).join(' ') || 'የYEMA ክፍያ';

  if (!amount || isNaN(amount)) {
    return ctx.reply('እባክዎ ትክክለኛ ዋጋ ያስገቡ። ለምሳሌ፡ ጫማ 1500');
  }

  const tx_ref = 'YM-' + Date.now();
  ctx.reply(`⏳ ለ"${itemName}" የ${amount} ETB የክፍያ ሊንክ እየተዘጋጀ ነው...`);

  try {
    const chapaRes = await axios.post(
      'https://api.chapa.co/v1/transaction/initialize',
      {
        amount: amount.toString(),
        currency: 'ETB',
        email: 'customer@yema.et',
        first_name: 'Customer',
        tx_ref: tx_ref,
        callback_url: 'https://example.com',
        customization: {
          title: `YEMA Pay - ${itemName}`,
          description: `${amount} ETB ክፍያ`
        }
      },
      {
        headers: {
          Authorization: `Bearer ${CHAPA_SECRET}`,
          'Content-Type': 'application/json'
        }
      }
    );

    if (chapaRes.data && chapaRes.data.data && chapaRes.data.data.checkout_url) {
      const payUrl = chapaRes.data.data.checkout_url;
      ctx.reply(
        `✅ የክፍያ ሊንክ ዝግጁ ነው!\n\n📦 ዕቃ፡ ${itemName}\n💰 ዋጋ፡ ${amount} ETB\n\n👇 ከታች ያለውን አዝራር ተጭነው በቴሌብር ወይም በሲቢኢ ይክፈሉ፡`,
        Markup.inlineKeyboard([
          Markup.button.url('📲 አሁን ክፈል (Telebirr / CBE)', payUrl)
        ])
      );
    } else {
      ctx.reply('የክፍያ ሊንኩን ማመንጨት አልተቻለም። እባክዎ እንደገና ይሞክሩ።');
    }
  } catch (error) {
    ctx.reply('የክፍያ ሊንክ ማመንጨት ላይ ስህተት አጋጥሟል።');
  }
});

bot.launch().then(() => {
  console.log('YEMA Pay Telegram Bot is active!');
});

app.get('/', (req, res) => res.send('YEMA Pay Engine is Running!'));
app.listen(PORT, () => console.log(`Server listening on port ${PORT}`));
